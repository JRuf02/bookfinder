{
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "files.exclude": {
    "**/*Zone.Identifier": true,
    "**/__pycache__/**": true,
    "**/.mypy_cache/**": true,
    "**/node_modules/**": true,
    "**/.ruff_cache/**": true,
    "**/.pytest_cache/**": true
  },
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/node_modules/**": true,
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true
  },
  "eslint.workingDirectories": ["frontend"],
  "python.analysis.extraPaths": ["./backend"],
  "python.defaultInterpreterPath": "/workspaces/bookfinder-venv/.venv/bin/python",
  "mypy-type-checker.importStrategy": "fromEnvironment",
  "mypy-type-checker.interpreter": [
    "/workspaces/bookfinder-venv/.venv/bin/python"
  ],
  "mypy-type-checker.reportingScope": "workspace",
  "js/ts.tsserver.maxMemory": 4096,
  "js/ts.tsserver.watchOptions": {
    "watchFile": "useFsEvents",
    "watchDirectory": "useFsEvents",
    "fallbackPolling": "dynamicPriorityPolling",
    "excludeDirectories": [
      "**/node_modules",
      "**/.venv",
      "**/backend",
      "**/.git",
      "**/documentation",
      "**/.mypy_cache",
      "**/__pycache__",
      "**/.ruff_cache"
    ]
  },
  "js/ts.tsserver.automaticTypeAcquisition.enabled": false,
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "never",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "ruff.configuration": "${workspaceFolder}/.ruff.toml",
  "ruff.nativeServer": "on",
  "ruff.configurationPreference": "filesystemFirst",
  "ruff.path": ["/workspaces/bookfinder-venv/.venv/bin/ruff"]
}
