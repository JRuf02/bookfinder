{
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "runArgs": ["-p", "5173:5173", "-p", "5000:5000"],
  "forwardPorts": [5173, 5000],
  "portsAttributes": {
    "5173": {
      "label": "Vite Dev Server",
      "onAutoForward": "notify"
    },
    "5000": {
      "label": "Flask API Server",
      "onAutoForward": "notify"
    }
  },
  "mounts": [],
  "customizations": {
    "vscode": {
      "extensions": [
        // General
        "ms-azuretools.vscode-docker",
        "GitHub.copilot",
        // React / TypeScript
        "dbaeumer.vscode-eslint", // can be run with 'npm run lint'
        "esbenp.prettier-vscode",
        // Python
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-python.vscode-pylance",
        "ms-python.mypy-type-checker"
      ]
    }
  }
}
