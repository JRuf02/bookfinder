{
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "runArgs": ["-p", "5173:5173", "-p", "5000:5000", "-p", "80:80"],
  "forwardPorts": [5173, 5000, 80],
  "portsAttributes": {
    "5173": {
      "label": "Vite Dev Server",
      "onAutoForward": "notify"
    },
    "5000": {
      "label": "Flask API Server",
      "onAutoForward": "notify"
    }
  },
  "mounts": [
    "source=isbn-scanner-nodemodules,target=/workspaces/isbn-scanner/frontend/node_modules,type=volume"
  ], // Mount the node_modules folder as a volume to avoid tsserver loading for ages
  "customizations": {
    "vscode": {
      "extensions": [
        // General
        "ms-azuretools.vscode-docker",
        "GitHub.copilot",
        "qwtel.sqlite-viewer",
        // React / TypeScript
        "dbaeumer.vscode-eslint", // can be run with 'npm run lint'
        "esbenp.prettier-vscode",
        // Python
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-python.vscode-pylance",
        "ms-python.mypy-type-checker"
      ]
    }
  }
}
