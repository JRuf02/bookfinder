{
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "forwardPorts": [5173, 5000, 443],
  "portsAttributes": {
    "5173": { "label": "Vite Dev Server", "onAutoForward": "notify" },
    "5000": { "label": "Flask API Server", "onAutoForward": "notify" },
    "443": {
      "label": "HTTPS",
      "onAutoForward": "notify",
      "elevateIfNeeded": true
    }
  },
  "mounts": [
    "source=bookfinder-nodemodules,target=/workspaces/bookfinder/frontend/node_modules,type=volume"
  ], // Mount the node_modules folder as a volume to avoid tsserver loading for ages
  "postCreateCommand": "make setup", // Will be run once after the container is created
  "customizations": {
    "vscode": {
      "extensions": [
        // General
        "ms-azuretools.vscode-docker",
        "qwtel.sqlite-viewer",
        // React / TypeScript
        "dbaeumer.vscode-eslint", // can be run with 'npm run lint'
        "esbenp.prettier-vscode",
        // Python
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-python.vscode-pylance",
        "ms-python.mypy-type-checker"
      ]
    }
  }
}
