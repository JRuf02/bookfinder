{
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "runArgs": [],
  "forwardPorts": [5173, 5000],
  "mounts": [],
  "postCreateCommand": "npm install && chmod +x /workspaces/isbn-scanner/start-all.sh && cd /workspaces/isbn-scanner/frontend && npm install",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint", // can be run with 'npm run lint'
        "ms-azuretools.vscode-docker",
        "GitHub.copilot",
        "esbenp.prettier-vscode",
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/workspaces/isbn-scanner/.venv/bin/python"
      }
    }
  }
}
